# ===== 通知模式 =====
# bot     : 只用 Discord Bot 私訊通知 (支援「標記已讀」按鈕、可在 Discord 內完成 Google 授權)
# webhook : 只用 Discord Webhook 推送到頻道 (不需 Bot Token，但無互動按鈕；Google 授權改在終端機完成)
# both    : 兩者同時發送
# 留空時會依照下方填寫了哪些變數自動判斷
NOTIFY_MODE=

# ===== Discord Bot (bot / both 模式必填) =====
DISCORD_TOKEN=your_discord_bot_token_here
DISCORD_TARGET_USER_ID=your_discord_user_id_here

# ===== Discord Webhook (webhook / both 模式必填) =====
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxx/xxxxxxxx

# ===== 其他 =====
GMAIL_POLLING_INTERVAL_MINUTES=1
# 本地資料庫加密金鑰。未設定時會改用 DISCORD_TOKEN。
# 純 webhook 模式下建議填寫一段隨機字串，避免憑證以預設金鑰加密。
STORAGE_SECRET=
